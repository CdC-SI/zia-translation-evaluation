# Copy this file to `.env` and adjust values as needed.
# All variables are optional; defaults shown below match the code's built-in
# fallbacks. Paths may be absolute or relative to the project root.

# --- translation.py ---------------------------------------------------------
ZIA_TRANSLATION_URL="http://localhost:8080/zia-trad/api/translation"
REQUEST_TIMEOUT=300.0
POLL_TIMEOUT=600.0
POLL_INITIAL_INTERVAL=1.0
POLL_MAX_INTERVAL=30.0
POLL_BACKOFF_FACTOR=2.0

# --- evaluation.py -----------------------------------------------------------
LLM_JUDGE_URL=""
LLM_JUDGE_MODEL_NAME=""
# path to ca certificate
CA_BUNDLE=""
LLM_JUDGE_API_KEY="non-empty-string"

LLM_JUDGE_PROMPT="prompts/evaluation_prompt.md"
LLM_JUDGE_TEMPERATURE=0.0
LLM_JUDGE_MAX_TOKEN=16384
LLM_JUDGE_MAX_CHAR=64000
LLM_JUDGE_RENDER_DPI=200
LLM_JUDGE_REQUEST_TIMEOUT=300.0